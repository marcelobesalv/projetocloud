# Copie para .env (ignorado pelo git) e ajuste. Valores só para o ambiente local.
POSTGRES_PASSWORD=postgres_local
CHAT_DB_PASSWORD=chat_local
COMMERCE_DB_PASSWORD=commerce_local
WORKER_DB_PASSWORD=worker_local
LOG_LEVEL=INFO

# Somente para docker-compose.bedrock.yml
# us-east-2 -> us.anthropic.claude-haiku-5-5 | sa-east-1 -> global.anthropic.claude-haiku-5-5
AWS_PROFILE=meu-perfil
AWS_REGION=us-east-2
LLM_MODEL_ID=us.anthropic.claude-haiku-5-5
# Só no Linux: descomente e preencha com $(id -u) / $(id -g) para o container ler ~/.aws.
# Sem isso o chat-api roda como 10001:10001 (usuário da imagem), o que basta no Windows/macOS.
# LOCAL_UID=1000
# LOCAL_GID=1000
